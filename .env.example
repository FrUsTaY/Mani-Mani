# ==============================================================================
# Mani-Mani Sync-Lab Service Configuration
# Copy this file to .env before starting the container:
#   cp .env.example .env
# ==============================================================================

# Port exposed on the host machine
SYNC_LAB_PORT=8000

# Path on the host machine for persistent SQLite database and user data
# Ensure this directory is owned by UID 10001 (appuser):
#   sudo chown -R 10001:10001 ./data
SYNC_LAB_HOST_DATA_DIR=./data

# Logging verbosity level (DEBUG, INFO, WARNING, ERROR)
SYNC_LAB_LOG_LEVEL=INFO

# CORS Allowed Origins (comma-separated or * for mobile / cross-origin clients)
SYNC_LAB_ALLOWED_ORIGINS=*

# Playwright browser runner mode (true for server / headless environments)
SYNC_LAB_HEADLESS=true
